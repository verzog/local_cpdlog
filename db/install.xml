<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/cpdlog/db" VERSION="20260924" COMMENT="XMLDB file for Moodle local/cpdlog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_cpdlog_category" COMMENT="CPD categories. Soft-disabled rather than deleted so entries are never orphaned.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="evidencerequired" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether submission requires at least one evidence file."/>
        <FIELD NAME="allowexternal" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether members may log activities outside Moodle (external) in this category."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="shortname" UNIQUE="true" FIELDS="shortname"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_period" COMMENT="Reporting periods. enddate is exclusive: the start of the day after the last day.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Start of the first day, inclusive."/>
        <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Start of the day after the last day, exclusive."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="open" SEQUENCE="false" COMMENT="open or closed. Closing locks the period's entries."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="startdate-enddate" UNIQUE="false" FIELDS="startdate, enddate"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_target" COMMENT="Required hours in a period, optionally for one cohort. Counts the linked categories, or all categories if none are linked.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="periodid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="cohortid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Null means the target applies to all members."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="requiredhours" TYPE="number" LENGTH="8" NOTNULL="true" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="periodid" TYPE="foreign" FIELDS="periodid" REFTABLE="local_cpdlog_period" REFFIELDS="id"/>
        <KEY NAME="cohortid" TYPE="foreign" FIELDS="cohortid" REFTABLE="cohort" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_cpdlog_target_cat" COMMENT="Categories counted towards a target. One row for a per-category target, several for a combined target.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="targetid" TYPE="foreign" FIELDS="targetid" REFTABLE="local_cpdlog_target" REFFIELDS="id"/>
        <KEY NAME="categoryid" TYPE="foreign" FIELDS="categoryid" REFTABLE="local_cpdlog_category" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="targetid-categoryid" UNIQUE="true" FIELDS="targetid, categoryid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_cohortchoice" COMMENT="Staff choice of which cohort's targets apply to a member in several cohorts with conflicting targets.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="periodid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="cohortid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Null means the all-members targets apply."/>
        <FIELD NAME="chosenby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="periodid" TYPE="foreign" FIELDS="periodid" REFTABLE="local_cpdlog_period" REFFIELDS="id"/>
        <KEY NAME="cohortid" TYPE="foreign" FIELDS="cohortid" REFTABLE="cohort" REFFIELDS="id"/>
        <KEY NAME="chosenby" TYPE="foreign" FIELDS="chosenby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-periodid" UNIQUE="true" FIELDS="userid, periodid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_entry" COMMENT="One row per logged CPD activity. Owned by the system named in source.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="periodid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Null for iMIS-origin rows. Kept if the course is deleted."/>
        <FIELD NAME="coursename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Course name when logged, so the entry stays readable if the course is deleted."/>
        <FIELD NAME="activityname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="For an external activity (no course): its name."/>
        <FIELD NAME="provider" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="For an external activity: who provided it."/>
        <FIELD NAME="hours" TYPE="number" LENGTH="6" NOTNULL="true" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="activitydate" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="descriptionformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft, submitted, approved, rejected or reversed."/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="moodle" SEQUENCE="false" COMMENT="moodle or imis: the system that owns the row."/>
        <FIELD NAME="externalref" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="The counterpart row's identifier in the other system."/>
        <FIELD NAME="syncstatus" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="pending, sent, failed or conflict. Null when not replicated."/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Staff member who last approved or rejected the entry."/>
        <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rejectionreason" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reversedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timereversed" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reversalreason" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The user who last changed the entry."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="categoryid" TYPE="foreign" FIELDS="categoryid" REFTABLE="local_cpdlog_category" REFFIELDS="id"/>
        <KEY NAME="periodid" TYPE="foreign" FIELDS="periodid" REFTABLE="local_cpdlog_period" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="reviewedby" TYPE="foreign" FIELDS="reviewedby" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="reversedby" TYPE="foreign" FIELDS="reversedby" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-periodid" UNIQUE="false" FIELDS="userid, periodid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="source-externalref" UNIQUE="true" FIELDS="source, externalref"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_deletion" COMMENT="Register of staff deletions of a member's CPD data. Kept after the data itself is deleted.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The member whose CPD data is deleted."/>
        <FIELD NAME="requestedby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The staff member who asked for the deletion."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="queued" SEQUENCE="false" COMMENT="queued, done or cancelled."/>
        <FIELD NAME="entriesdeleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="filesdeleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timerequested" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="When the deletion ran or was cancelled."/>
        <FIELD NAME="imageblogawardid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The member's highest image blog award id when the deletion ran; awards up to it are not copied again."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="requestedby" TYPE="foreign" FIELDS="requestedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_reminder" COMMENT="Reminders sent to members before a reporting period closes, so none is sent twice.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The member reminded."/>
        <FIELD NAME="periodid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The period about to close."/>
        <FIELD NAME="daysbefore" TYPE="int" LENGTH="5" NOTNULL="true" SEQUENCE="false" COMMENT="The reminder point, in days before the period's last day."/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="periodid" TYPE="foreign" FIELDS="periodid" REFTABLE="local_cpdlog_period" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-periodid-daysbefore" UNIQUE="true" FIELDS="userid, periodid, daysbefore"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_completion" COMMENT="Staff decisions on course completions: released to the member's logbook, or excluded.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The member who completed the course."/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The course completed."/>
        <FIELD NAME="entryid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The entry released; none if excluded. It may since have been deleted."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="released" SEQUENCE="false" COMMENT="released or excluded."/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="actionedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The staff member who released or excluded it; 0 once their own CPD data is deleted."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-courseid" UNIQUE="true" FIELDS="userid, courseid"/>
        <INDEX NAME="courseid-status" UNIQUE="false" FIELDS="courseid, status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_import_run" COMMENT="Audits of CPD history from another system (iMIS or a CSV file), run by staff or the nightly task.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="imis or csv."/>
        <FIELD NAME="memberid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="The one member audited, by their ID in the source; null for everyone."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="audited" SEQUENCE="false" COMMENT="audited, queued, imported or failed."/>
        <FIELD NAME="counts" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: rows by outcome."/>
        <FIELD NAME="requestedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The staff member who ran it; 0 for the nightly task or once their own data is deleted."/>
        <FIELD NAME="importedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The staff member who imported it; 0 for none, the nightly task, or once their own data is deleted."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="source-timecreated" UNIQUE="false" FIELDS="source, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_import_row" COMMENT="One audited CPD record from the source, with its outcome and what it would become in the logbook.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="runid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="rowkey" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The source row's key and the category: becomes the entry's externalref."/>
        <FIELD NAME="memberid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="The member's ID in the source."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The matching Moodle user; null if none."/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="periodid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="activitydate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="hours" TYPE="number" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="outcome" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="new, existing, changed, conflict, unmatched or skipped."/>
        <FIELD NAME="reason" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Why a row is unmatched or changed."/>
        <FIELD NAME="matchentryid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The logbook entry it matches or conflicts with."/>
        <FIELD NAME="decision" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="For a conflict: import or skip."/>
        <FIELD NAME="decidedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The staff member who decided; 0 for none or once their own data is deleted."/>
        <FIELD NAME="timedecided" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="entryid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The entry it was imported as."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="runid" TYPE="foreign" FIELDS="runid" REFTABLE="local_cpdlog_import_run" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="runid-outcome" UNIQUE="false" FIELDS="runid, outcome"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="rowkey" UNIQUE="false" FIELDS="rowkey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_cpdlog_push" COMMENT="Approved entries sent to iMIS: the iMIS row they became, and the state of the last send.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="entryid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="target" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="object or activity: where the row was written."/>
        <FIELD NAME="imiskey" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="The iMIS row's key, such as ID|Ordinal; null until it is created."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="pending, sent, dryrun, failed or skipped."/>
        <FIELD NAME="action" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="The last thing sent or due: create, update or reverse."/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="The last body sent, or that would be sent in a dry run."/>
        <FIELD NAME="error" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Why the last send failed or was skipped."/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="entryid" TYPE="foreign-unique" FIELDS="entryid" REFTABLE="local_cpdlog_entry" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="imiskey" UNIQUE="false" FIELDS="imiskey"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
